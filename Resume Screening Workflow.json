    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"years_of_experience\": {\n      \"type\": \"number\",\n      \"description\": \"Total years of relevant professional experience.\"\n    },\n    \"skills\": {\n      \"type\": \"array\",\n      \"description\": \"The candidate's technical skills.\",\n      \"items\": { \"type\": \"string\" }\n    },\n    \"education\": {\n      \"type\": \"string\",\n      \"description\": \"Degree, field, and university.\"\n    },\n    \"experience_summary\": {\n      \"type\": \"string\",\n      \"description\": \"Two or three sentences summarizing the candidate's experience.\"\n    },\n    \"candidate_strengths\": {\n      \"type\": \"array\",\n      \"description\": \"Specific strengths that match the job requirements.\",\n      \"items\": { \"type\": \"string\" }\n    },\n    \"candidate_weaknesses\": {\n      \"type\": \"array\",\n      \"description\": \"Areas where the candidate falls short of the job requirements.\",\n      \"items\": { \"type\": \"string\" }\n    },\n    \"risk_factor\": {\n      \"type\": \"object\",\n      \"description\": \"The potential downside of hiring this candidate.\",\n      \"properties\": {\n        \"score\": { \"type\": \"string\", \"enum\": [\"Low\", \"Medium\", \"High\"] },\n        \"explanation\": { \"type\": \"string\", \"description\": \"The worst-case scenario if the candidate is hired.\" }\n      },\n      \"required\": [\"score\", \"explanation\"]\n    },\n    \"reward_factor\": {\n      \"type\": \"object\",\n      \"description\": \"The potential upside of hiring this candidate.\",\n      \"properties\": {\n        \"score\": { \"type\": \"string\", \"enum\": [\"Low\", \"Medium\", \"High\"] },\n        \"explanation\": { \"type\": \"string\", \"description\": \"The best-case scenario and whether the candidate is a short-term or long-term fit.\" }\n      },\n      \"required\": [\"score\", \"explanation\"]\n    },\n    \"overall_fit_rating\": {\n      \"type\": \"integer\",\n      \"description\": \"A whole number from 0 to 10.\",\n      \"minimum\": 0,\n      \"maximum\": 10\n    },\n    \"justification_for_rating\": {\n      \"type\": \"string\",\n      \"description\": \"Why the candidate received this score, referencing specific resume content.\"\n    }\n  },\n  \"required\": [\n    \"years_of_experience\",\n    \"skills\",\n    \"education\",\n    \"experience_summary\",\n    \"candidate_strengths\",\n    \"candidate_weaknesses\",\n    \"risk_factor\",\n    \"reward_factor\",\n    \"overall_fit_rating\",\n    \"justification_for_rating\"\n  ]\n}",
        "autoFix": true
      },
